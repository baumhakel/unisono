dat3 <- sim3$dat
dat3 <- ifelse(dat3 > 0, "+", "-")
sim3.l <- lapply(1:nrow(dat3), function(i) dat3[i,])
dim(sim3.l) <- c(10, 10, 10)

# custom objective function (x is single observation, y is list of observations)
f3 <- function(x, yl) {
  return(sapply(yl, function(y) {sum(unlist(x) != unlist(y))}))
