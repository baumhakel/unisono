sim2 <- geoR::grf(grid = expand.grid(1:30, 1:30), nsim = 2,
                  cov.pars = c(1, 2), aniso.pars = c(0,2))

# test 2 sets of lags simultaneously
lags_list = list(rbind(diag(2, 2), diag(-2, 2)),
